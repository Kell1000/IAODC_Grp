# =====================================================================
#  WikiNLP Assistant - Exemple de configuration
# =====================================================================
#  USAGE :
#    1. Copier ce fichier :  Copy-Item .env.example .env
#    2. Remplir les valeurs dans .env
#    3. NE JAMAIS committer .env (il est deja dans .gitignore)
#
#  Le projet fonctionne SANS AUCUNE CLE API en mode demonstration
#  (LLM_PROVIDER=extractive). Les cles ne servent qu'a la generation.
# =====================================================================

# ---------------------------------------------------------------------
# 1. COLLECTE WIKIPEDIA
# ---------------------------------------------------------------------
# Langue du corpus Wikipedia : fr, en, es...
WIKI_LANG=fr

# User-Agent OBLIGATOIRE par la politique d'acces de Wikimedia.
# Remplacez par votre nom/email reel : une valeur generique peut etre bloquee.
# Format recommande : NomProjet/version (contact)
WIKI_USER_AGENT=WikiNLP-Assistant/1.0 (etudiant@example.com)

# Nombre maximum d'articles a collecter (garde-fou memoire/disque)
MAX_ARTICLES=30

# Pause entre deux requetes Wikipedia, en secondes (politesse / anti-429)
WIKI_SLEEP=0.5

# ---------------------------------------------------------------------
# 2. DECOUPAGE ET RECHERCHE
# ---------------------------------------------------------------------
# Taille des chunks en caracteres, et chevauchement entre chunks
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Nombre de passages renvoyes par la recherche
TOP_K=4

# --- Seuil du garde-fou anti-hallucination ---------------------------
# En dessous de ce score, le chatbot repond "je ne sais pas" au lieu
# d'inventer. ATTENTION : les scores de TF-IDF et des embeddings ne sont
# PAS sur la meme echelle, il y a donc UN SEUIL PAR MOTEUR.
#
# Mesure faite pendant le TP (corpus de 1 345 chunks, les DEUX moteurs),
# sur le jeu officiel de 8 questions :
#   TF-IDF     : dans le corpus 0,151-0,205 | hors corpus 0,081-0,121
#   -> un seuil unique de 0,25 refusait TOUTES les questions legitimes.
#   EMBEDDINGS : dans le corpus 0,821-0,897 | hors corpus 0,230-0,365
#   -> a 0,30, une question hors sujet passait (score 0,3652) et le taux de
#      refus hors corpus tombait a 0,667.
#
# Puis sur une sonde elargie de 20 questions, qui nuance le tableau :
#   TF-IDF     : dans le corpus 0,105-0,234 | hors corpus 0,076-0,139
#   -> les deux populations SE RECOUVRENT. 0,13 n'est donc pas un
#      separateur parfait, seulement le meilleur compromis disponible.
#   EMBEDDINGS : dans le corpus 0,495-0,897 | hors corpus 0,186-0,365
#   -> l'ecart utile est 0,365-0,495 et 0,43 en est le milieu exact.
#      Ne montez pas vers 0,55 : la question legitime "Qu'est-ce que le
#      TAL ?" a pour meilleur score 0,4954 et serait refusee en bloc,
#      alors que le bon passage figure bien dans ses 4 premiers.
#
# Reglage : montez le seuil s'il repond hors sujet, baissez-le s'il refuse
# des questions legitimes. `python -m src.evaluate` mesure les deux erreurs.
MIN_SCORE_TFIDF=0.13
MIN_SCORE_EMBEDDINGS=0.43

# Optionnel : force le MEME seuil pour les deux moteurs.
# Laissez vide pour utiliser les deux valeurs ci-dessus (recommande).
MIN_SCORE=

# ---------------------------------------------------------------------
# 3. MOTEUR DE RECHERCHE (retrieval)
# ---------------------------------------------------------------------
# RETRIEVER : tfidf | embeddings
#   tfidf      -> lexical, scikit-learn seul, aucun modele a telecharger (~0 Mo)
#   embeddings -> semantique, sentence-transformers (telecharge un modele)
RETRIEVER=embeddings

# Modele d'embeddings (utilise seulement si RETRIEVER=embeddings)
#   paraphrase-multilingual-MiniLM-L12-v2 -> ~470 Mo, multilingue (FR OK)
#   all-MiniLM-L6-v2                      -> ~90 Mo, ANGLAIS seulement
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Base vectorielle : numpy | chroma
#   numpy  -> index plat exact, aucune dependance supplementaire (defaut)
#   chroma -> ChromaDB persistant (pip install chromadb)
VECTOR_BACKEND=numpy

# ---------------------------------------------------------------------
# 4. MODELE DE LANGUE (LLM)
# ---------------------------------------------------------------------
# LLM_PROVIDER : extractive | groq | gemini | ollama
#   extractive -> AUCUNE cle, aucun reseau : renvoie les passages tels quels
#   groq       -> API gratuite (console.groq.com) - verifiez vos quotas
#   gemini     -> API gratuite (aistudio.google.com) - verifiez vos quotas
#   ollama     -> LLM local via Ollama (aucune cle, ~1 a 3 Go de RAM)
LLM_PROVIDER=extractive

# --- Groq (https://console.groq.com/keys) -----------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Google Gemini (https://aistudio.google.com/apikey) ---------------
# ATTENTION : sur l'offre gratuite, Google peut utiliser vos requetes
# pour ameliorer ses modeles. N'y envoyez pas de donnees sensibles.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Ollama local (https://ollama.com) --------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b-instruct

# Parametres de generation
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TIMEOUT=60

# ---------------------------------------------------------------------
# 5. CACHES (important : C: est souvent le disque le plus petit)
# ---------------------------------------------------------------------
# Redirige le cache des modeles Hugging Face dans le projet (sur D:)
# au lieu de C:\Users\<vous>\.cache\huggingface
HF_HOME=./hf_cache
